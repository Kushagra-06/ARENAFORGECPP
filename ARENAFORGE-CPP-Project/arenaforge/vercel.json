{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": "web",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/arenaforge.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    }
  ]
}
